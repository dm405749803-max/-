{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tongpin.local/schemas/knowledge-document-v1.json",
  "title": "Tongpin knowledge document v1",
  "type": "object",
  "required": [
    "document_id",
    "version",
    "title",
    "knowledge_type",
    "scopes",
    "lifecycle_status",
    "index_status",
    "verification_status",
    "customer_use",
    "valid_from",
    "source",
    "topics",
    "chunks"
  ],
  "properties": {
    "document_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "knowledge_type": {"enum": ["product", "contract", "experience", "platform"]},
    "product_id": {"type": ["string", "null"]},
    "product_version": {"type": ["string", "null"]},
    "policy_contract_versions": {"type": "array", "items": {"type": "string"}},
    "scopes": {"type": "array", "items": {"enum": ["new_consultation", "contract_service"]}, "minItems": 1},
    "lifecycle_status": {"enum": ["active", "archived_serviceable", "expired", "pending"]},
    "index_status": {"enum": ["ready", "pending", "failed"]},
    "verification_status": {"enum": ["business_verified", "public_source_checked", "confirmed_training", "unverified"]},
    "customer_use": {"enum": ["approved", "approved_for_simulation", "business_review_required", "internal_process_only", "blocked"]},
    "valid_from": {"type": "string", "format": "date"},
    "valid_to": {"type": ["string", "null"], "format": "date"},
    "source": {
      "type": "object",
      "required": ["publisher", "label", "url", "retrieved_at"],
      "properties": {
        "publisher": {"type": "string"},
        "label": {"type": "string"},
        "url": {"type": ["string", "null"]},
        "retrieved_at": {"type": "string", "format": "date"}
      }
    },
    "topics": {"type": "array", "items": {"type": "string"}},
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["location", "keywords", "text"],
        "properties": {
          "location": {"type": "string"},
          "keywords": {"type": "array", "items": {"type": "string"}},
          "text": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
